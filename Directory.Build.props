<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Training is an opt-in build feature. Keep it absent from normal builds and let the
         Makefile pass EnableTraining=true for development builds that need it. -->
    <EnableTraining Condition="'$(EnableTraining)' == ''">false</EnableTraining>
    <DefineConstants Condition="'$(EnableTraining)' == 'true'">$(DefineConstants);TRIPT_TRAINING</DefineConstants>
    <!-- Both target frameworks are carried from the first commit even while only one is exercised:
         retrofitting a second TFM later costs more than carrying an idle one. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Restore writes a packages.lock.json per project and then honours it, so a transitive version
         cannot drift between machines or over time. The Windows bundle depends on this concretely:
         publish-shell-win ships Photino.Native's win-x64 payload, and Photino.Native is a TRANSITIVE
         dependency of Photino.NET that nothing else pins. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.1.0-alpha.2</Version>
  </PropertyGroup>
</Project>
