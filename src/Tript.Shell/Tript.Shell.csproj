<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tript.Shell</RootNamespace>
    <AssemblyName>Tript.Shell</AssemblyName>
    <!-- The desktop shell is a thin native launcher: it hosts the Photino webview pointed at the
         app's UI host, and reuses Tript.App's construction seam (AppHost.BuildApp). Like the app
         host, it must be an apphost executable so the ffmpeg_muxer plugin can resolve its helper
         next to the actual binary. -->
    <Platforms>x64</Platforms>
    <!-- WinExe, not Exe: the subsystem bit is what decides whether Windows opens a console window
         for the process. A desktop app that shows a Photino window must not also raise an empty
         console behind it, which is exactly what the console subsystem does. The flag is a no-op
         on Linux (there is no subsystem field in ELF), so the same project serves both platforms
         and `dotnet run` still prints to the terminal that launched it. -->
    <OutputType>WinExe</OutputType>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>../Tript.Web/public/tript.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <!-- Native Windows toast notifications need a Windows-flavored TFM to expose ToastContentBuilder
       at all; scoped to just that TFM the same way EnableTraining/TRIPT_TRAINING keeps an opt-in
       feature out of every build. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS_TOAST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Microsoft.Toolkit.Uwp.Notifications 7.1.3 transitively pulls System.Drawing.Common 4.7.0,
         which has a known critical RCE (GHSA-rxg9-xrhp-64gj, Mac/Linux-only, and we never call into
         its API surface ourselves either way) — pin explicitly to a patched version. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shell's startup preflights are decision logic worth asserting (WebviewAudioSink refuses
         to open a window WebKitGTK would abort behind), and the app test suite is where the host's
         other platform preflight is pinned, so it sees the shell's internals too. Nothing in the
         window itself is testable off a display, and none of these tests start a host. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tript.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tript.App/Tript.App.csproj" />
  </ItemGroup>
</Project>
