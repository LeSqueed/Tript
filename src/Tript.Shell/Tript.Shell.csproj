<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tript.Shell</RootNamespace>
    <AssemblyName>Tript.Shell</AssemblyName>
    <!-- The desktop shell is a thin native launcher: it hosts the Photino webview pointed at the
         app's UI host, and reuses Tript.App's construction seam (AppHost.BuildApp). Like the app
         host, it must be an apphost executable so the ffmpeg_muxer plugin can resolve its helper
         next to the actual binary. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>x64</Platforms>
    <!-- WinExe, not Exe: the subsystem bit is what decides whether Windows opens a console window
         for the process. A desktop app that shows a Photino window must not also raise an empty
         console behind it, which is exactly what the console subsystem does. The flag is a no-op
         on Linux (there is no subsystem field in ELF), so the same project serves both platforms
         and `dotnet run` still prints to the terminal that launched it. -->
    <OutputType>WinExe</OutputType>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tript.App/Tript.App.csproj" />
  </ItemGroup>
</Project>
