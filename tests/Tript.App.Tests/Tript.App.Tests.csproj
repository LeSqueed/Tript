<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tript.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The app host is a net10.0 (non-windows) apphost; the smoke tests spawn it as a child and
         bind the same three ports. Run with `-f net10.0` so `dotnet test` runs the suite once.
         The TFMs are inherited (not restricted to net10.0): forcing a single TFM here breaks
         xunit.runner.visualstudio's adapter copy into the output, and discovery then fails with
         "No test is available". -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <!-- Machine-dependent tests (a real recorder needs a display, the clip and thumbnail tests need
         ffmpeg) opt out with a dynamic skip. xunit 2.x does NOT honour one: Xunit.Sdk.SkipException
         compiles and throws the $XunitDynamicSkip$ token, but nothing in v2 translates it, so every
         such test was reported as a FAILURE — which is how CI first went red on a runner with no
         display. SkippableFact is what translates the token; the tests carry [SkippableFact] /
         [SkippableTheory] and throw Xunit.SkipException. Assert.Skip is xunit v3 and is not
         available here. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tript.App\Tript.App.csproj" />
    <!-- The desktop shell is here for its startup preflight only (WebviewAudioSinkTests): pure
         decision logic over injected probes, no window and no Photino call. The shell has no test
         project of its own, and the host's other platform preflight (SafeModuleAllowlistTests) is
         already pinned here. -->
    <ProjectReference Include="..\..\src\Tript.Shell\Tript.Shell.csproj" />
  </ItemGroup>
</Project>
